GEMINI_API_KEY=

# --- Optional (defaults shown) ---
# Answer model, and a second Gemini model used when the first is out of quota or overloaded
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_FALLBACK_MODEL=gemini-3.5-flash
# Printed-text OCR: auto (Tesseract if installed, else docTR), tesseract, or doctr
# OCR_ENGINE=auto
# Handwriting line finder: doctr or projection; erase notebook rules first
# HTR_SEGMENTER=doctr
# REMOVE_RULED_LINES=true
# TrOCR temperature scaling; fit with `python -m evaluation.fit_htr_temperature`
# HTR_TEMPERATURE=1.0
# --- PaddleOCR Experience Center (/studio) ---
# PADDLE_DEVICE=cpu                       # or gpu / gpu:0 with paddlepaddle-gpu installed
# PADDLE_OCR_VERSION=PP-OCRv5             # PP-OCRv6 also works (medium models, ~3x slower on CPU)
# PADDLE_DET_MODEL=PP-OCRv5_mobile_det
# PADDLE_REC_MODEL=en_PP-OCRv5_mobile_rec
# PADDLE_ENABLE_MKLDNN=false              # true crashes on Windows with paddle 3.3
# PADDLE_USE_ORIENTATION=false
# PADDLE_USE_UNWARPING=false
# PADDLE_USE_TEXTLINE_ORIENTATION=false
# PADDLE_PDF_DPI=150
# PADDLE_MAX_PAGES=30
# PADDLE_MAX_UPLOAD_MB=25
# PADDLE_FORMULA_MODEL=PP-FormulaNet_plus-S
# PADDLE_ENABLE_VL=false                  # PaddleOCR-VL: needs a GPU or a lot of patience
# REVIEW_THRESHOLD=0.70
# CALIBRATION_CER_THRESHOLD=0.1
# LOG_FORMAT=text                         # or json
# --- Shared documents and LLM refinement ---
# EXTRACTION_ENGINE=auto                  # paddle | classic (Tesseract/docTR + TrOCR) | auto
# INGEST_PIPELINE=structure               # QA-page uploads: structure (layout, tables) or ocr (faster)
# LLM_REFINE=true                         # refine every upload's text with Gemini (original kept)
# REFINE_MAX_CHANGE=0.4                   # reject a refined line changing more than 40% of its characters
