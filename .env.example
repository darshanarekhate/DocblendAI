GEMINI_API_KEY=

# --- Optional (defaults shown) ---
# Answer model, and a second Gemini model used when the first is out of quota or overloaded
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_FALLBACK_MODEL=gemini-3.5-flash
# Printed-text OCR: auto (Tesseract if installed, else docTR), tesseract, or doctr
# OCR_ENGINE=auto
# Handwriting line finder: doctr or projection; erase notebook rules first
# HTR_SEGMENTER=doctr
# REMOVE_RULED_LINES=true
# TrOCR temperature scaling; fit with `python -m evaluation.fit_htr_temperature`
# HTR_TEMPERATURE=1.0
